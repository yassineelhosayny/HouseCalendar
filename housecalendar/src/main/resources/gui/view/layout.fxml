<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane styleClass="root" stylesheets="@../style/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.controller.MainLayoutController">
    <fx:define>
        <ToggleGroup fx:id="gruppoFiltri" />
    </fx:define>
    <!-- Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>
            
            <!-- Logo e Titolo -->
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                <SVGPath styleClass="logo-icon-svg" scaleX="1.1" scaleY="1.1" content="M12 3l9 8h-3v10h-5v-6h-2v6H6V11H3z"/>
                <Label styleClass="app-title" text="HouseCalendar" />
            </HBox>
            
            <!-- User Info -->
            <HBox alignment="CENTER_RIGHT" spacing="15">
                <MenuButton styleClass="user-menu" text="Mario ▼" />
            </HBox>
        </HBox>
    </top>
    
    <!-- Sidebar Sinistra -->
    <left>
        <VBox prefWidth="280" spacing="0" styleClass="sidebar">
            <padding>
                <Insets bottom="20" left="0" right="0" top="20" />
            </padding>
            
            <!-- Titolo Filtri -->
            <HBox alignment="CENTER_LEFT" styleClass="sidebar-header">
                <padding>
                    <Insets bottom="10" left="20" right="20" top="10" />
                </padding>
                <Label styleClass="sidebar-title" text="☰ Filtri" />
            </HBox>
            
            <!-- Toggle Buttons Filtri -->
            <VBox spacing="5" styleClass="filter-group">
                <padding>
                    <Insets bottom="10" left="10" right="10" top="10" />
                </padding>
                <ToggleButton fx:id="filtroTutte" prefWidth="220" selected="true"
                              styleClass="filter-btn, filter-btn-active"
                              text="Tutte" onAction="#filtroTutte" toggleGroup="$gruppoFiltri">
                    <graphic>
                        <SVGPath styleClass="filter-icon" scaleX="0.5" scaleY="0.5" content="M12 4a8 8 0 1 0 0 16a8 8 0 1 0 0-16z"/>
                    </graphic>
                </ToggleButton>
                <ToggleButton fx:id="filtroPersonali" prefWidth="220" styleClass="filter-btn"
                              text="Personali" onAction="#filtroPersonali" toggleGroup="$gruppoFiltri">
                    <graphic>
                        <SVGPath styleClass="filter-icon" scaleX="0.5" scaleY="0.5" content="M12 4a8 8 0 1 0 0 16a8 8 0 1 0 0-16z"/>
                    </graphic>
                </ToggleButton>
                <ToggleButton fx:id="filtroCondivise" prefWidth="220" styleClass="filter-btn"
                              text="Condivise" onAction="#filtroCondivise" toggleGroup="$gruppoFiltri">
                    <graphic>
                        <SVGPath styleClass="filter-icon" scaleX="0.5" scaleY="0.5" content="M12 4a8 8 0 1 0 0 16a8 8 0 1 0 0-16z"/>
                    </graphic>
                </ToggleButton>
            </VBox>
            
            <!-- Calendario -->
            <VBox styleClass="calendar-container" VBox.vgrow="ALWAYS" minHeight="260" prefHeight="300" maxHeight="360">
                <padding>
                    <Insets bottom="20" left="15" right="15" top="30" />
                </padding>
                
                <!-- Intestazione Calendario -->
                <HBox alignment="CENTER" styleClass="calendar-header">
                    <Button styleClass="calendar-nav-btn" text="‹" onAction="#mesePrecedente" />
                    <Label fx:id="etichettaMese" styleClass="calendar-month" text="Aprile 2024" HBox.hgrow="ALWAYS" />
                    <Button styleClass="calendar-nav-btn" text="›" onAction="#meseSuccessivo" />
                </HBox>
                
                <!-- Griglia Calendario -->
                <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" prefViewportHeight="260"
                            styleClass="custom-scroll">
                    <content>
                        <GridPane fx:id="grigliaCalendario" hgap="2" styleClass="calendar-grid" vgap="2"
                                  maxWidth="Infinity" maxHeight="Infinity">
                            <padding>
                                <Insets top="10" />
                            </padding>
                            
                            <!-- Giorni della settimana -->
                            <Label styleClass="calendar-day-header" text="D" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <Label styleClass="calendar-day-header" text="L" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            <Label styleClass="calendar-day-header" text="M" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                            <Label styleClass="calendar-day-header" text="G" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                            <Label styleClass="calendar-day-header" text="V" GridPane.columnIndex="4" GridPane.rowIndex="0" />
                            <Label styleClass="calendar-day-header" text="S" GridPane.columnIndex="5" GridPane.rowIndex="0" />
                            
                            <!-- Giorni del mese (esempio) -->
                            <Label styleClass="calendar-day" text="1" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <Label styleClass="calendar-day" text="2" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            <Label styleClass="calendar-day" text="3" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                            <Label styleClass="calendar-day, calendar-day-selected" text="24" GridPane.columnIndex="3" GridPane.rowIndex="4" />
                       <columnConstraints>
                          <ColumnConstraints />
                          <ColumnConstraints />
                          <ColumnConstraints />
                          <ColumnConstraints />
                          <ColumnConstraints />
                          <ColumnConstraints />
                       </columnConstraints>
                       <rowConstraints>
                          <RowConstraints />
                          <RowConstraints />
                          <RowConstraints />
                          <RowConstraints />
                          <RowConstraints />
                       </rowConstraints>
                        </GridPane>
                    </content>
                </ScrollPane>
            </VBox>
        </VBox>
    </left>
    
    <!-- Area Principale -->
    <center>
    <VBox styleClass="main-content" spacing="20" fillWidth="true"
          prefHeight="600" minHeight="400">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>
        
        <!-- Titolo e ricerca -->
        <HBox alignment="CENTER_LEFT" spacing="20" prefHeight="50">
            <Label styleClass="page-title" text="Gestione Attività" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox styleClass="search-container" alignment="CENTER_LEFT" spacing="10">
                <SVGPath styleClass="search-icon-svg" scaleX="0.24" scaleY="0.24" content="M 21 3 C 11.601563 3 4 10.601563 4 20 C 4 29.398438 11.601563 37 21 37 C 24.355469 37 27.460938 36.015625 30.09375 34.34375 L 42.375 46.625 L 46.625 42.375 L 34.5 30.28125 C 36.679688 27.421875 38 23.878906 38 20 C 38 10.601563 30.398438 3 21 3 Z M 21 7 C 28.199219 7 34 12.800781 34 20 C 34 27.199219 28.199219 33 21 33 C 13.800781 33 8 27.199219 8 20 C 8 12.800781 13.800781 7 21 7 Z"/>
                <TextField fx:id="campoRicerca" styleClass="search-field" 
                          promptText="Cerca..." prefWidth="200" onAction="#applicaRicerca"/>
                <StackPane styleClass="search-select">
                    <MenuButton fx:id="menuRicerca" styleClass="search-menu-btn" text="Nome">
                        <items>
                            <MenuItem text="Cerca per nome" onAction="#cercaPerNome" />
                            <MenuItem text="Cerca per tipo" onAction="#cercaPerTipo" />
                            <MenuItem text="Cerca per data" onAction="#cercaPerData" />
                        </items>
                    </MenuButton>
                    <Label styleClass="search-select-triangle" text="▾" />
                </StackPane>
            </HBox>
        </HBox>

        <HBox styleClass="activity-header" alignment="CENTER_LEFT" spacing="15">
            <Label styleClass="activity-header-text" text="Completata" prefWidth="90" minWidth="90" />
            <Label styleClass="activity-header-text" text="Descrizione" prefWidth="230" minWidth="230" />
            <Label styleClass="activity-header-text" text="Tipo" prefWidth="130" minWidth="130" />
            <Label styleClass="activity-header-text" text="Data" prefWidth="120" minWidth="120" />
            <Label styleClass="activity-header-text" text="Ora" prefWidth="110" minWidth="110" />
            <Label styleClass="activity-header-text" text="Stato" prefWidth="110" minWidth="110" />
            <Label styleClass="activity-header-text" text="Utente" prefWidth="140" minWidth="140" />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="activity-header-text" text="Azioni" />
        </HBox>
<!-- Area attività con altezza fissa -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" 
                   prefHeight="400" minHeight="300"
                   styleClass="custom-scroll">
            <content>
                <VBox fx:id="contenitoreSchede" spacing="10" 
                      style="-fx-padding: 10; -fx-min-height: 300;">
                    <!-- Esempio riga -->
                    <HBox fx:id="rowExample" spacing="15" alignment="CENTER_LEFT" 
                          minHeight="70" prefHeight="70"
                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; 
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                        <padding>
                            <Insets left="20" right="20" />
                        </padding>
                        
                        <HBox prefWidth="90" minWidth="90" alignment="CENTER_LEFT">
                            <CheckBox selected="true" disable="true"/>
                        </HBox>

                        <VBox prefWidth="230" minWidth="230" alignment="CENTER_LEFT">
                            <Label text="Studio per esame" 
                                   styleClass="activity-title" 
                                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        </VBox>
                        
                        <HBox prefWidth="130" minWidth="130" alignment="CENTER_LEFT">
                            <Label text="Personale" styleClass="badge-personale"/>
                        </HBox>
                        
                        <VBox prefWidth="120" minWidth="120" alignment="CENTER_LEFT">
                            <Label text="30/04/2024" styleClass="activity-date"/>
                        </VBox>
                        
                        <VBox prefWidth="110" minWidth="110" alignment="CENTER_LEFT">
                            <Label text="15:00" styleClass="activity-time"/>
                        </VBox>

                        <HBox prefWidth="110" minWidth="110" alignment="CENTER_LEFT">
                            <Label text="IN CORSO" styleClass="stato-badge stato-in-corso"/>
                        </HBox>

                        <VBox prefWidth="140" minWidth="140" alignment="CENTER_LEFT">
                            <Label text="Mario Rossi" styleClass="activity-assigned"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <Button styleClass="btn-action, btn-edit" text="✏"/>
                            <Button styleClass="btn-action, btn-delete" text="🗑"/>
                        </HBox>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
        
        <!-- Pulsante aggiungi -->
        <HBox alignment="CENTER_RIGHT" prefHeight="50">
            <Button fx:id="btnAggiungi" styleClass="btn-primary" 
                    text="+ Aggiungi Attività"/>
        </HBox>
    </VBox>
</center>
</BorderPane>
